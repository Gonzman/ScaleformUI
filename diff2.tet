+            [159] = SColor.FromArgb(127, 106, 72)
+        };
+
+        public static SColor GetColorById(int id)
+        {
+            return vehColors[id];
+        }
+
+        public static int GetColorByRGB(int r, int g, int b)
+        {
+            if (IsCustomColor(r, g, b))
+                return -1;
+            return vehColors.FirstOrDefault(x => x.Value.R == r && x.Value.G == g && x.Value.B == b).Key;
+        }
+        public static bool IsCustomColor(int r, int g, int b) => !vehColors.Values.Any(x => x.R == r && x.G == g && x.B == b);
+
+        public static int GetColorByRGB(SColor color)
+        {
+            if (IsCustomColor(color.R, color.G, color.B))
+                return -1;
+            return vehColors.FirstOrDefault(x => x.Value.R == color.R && x.Value.G == color.G && x.Value.B == color.B).Key;
+        }
+    }
+}
