+        public override async void MouseEvent(int eventType, int context, int index)
+        {
+            if (!Focused) return;
+            switch (eventType)
+            {
+                case 5:
+                    if (CurrentColumnIndex == context)
+                    {
+                        if (CurrentColumn.Index != index)
+                        {
+                            switch (CurrentColumnIndex)
+                            {
