+        if dir > 0 and #self.Tabs > 0 and self.focusLevel == 1 then
+            self.Tabs[self.index]:Focus()
+        elseif (dir < 0 and #self.Tabs > 0 and self.focusLevel == 0) then
+            self.Tabs[self.index]:UnFocus()
