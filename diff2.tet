diff --git a/ScaleformUI_Csharp/Menus/Pause Menus/Elements/Columns/SubmenuCentralColumn.cs b/ScaleformUI_Csharp/Menus/Pause Menus/Elements/Columns/SubmenuCentralColumn.cs
