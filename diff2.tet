 ---@class SubmenuTab
-
 function SubmenuTab.New(name, color)
-    local data = {
-        Base = BaseTab.New(name or "", 1, color),
-        Label = name or "",
-        TextTitle = "",
-        LeftItemList = {},
-        Index = 0,
