-        local pSubT = self.Parent()
-        if pSubT == "LobbyMenu" then
-            ScaleformUI.Scaleforms._pauseMenu._lobby:CallFunction("CLEAR_SETTINGS_COLUMN")
-        elseif pSubT == "PauseMenu" then
