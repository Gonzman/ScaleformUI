diff --git a/ScaleformUI_Lua/src/Menus/PauseMenus/PauseMenu/Tabs/SubmenuTab.lua b/ScaleformUI_Lua/src/Menus/PauseMenus/PauseMenu/Tabs/SubmenuTab.lua
