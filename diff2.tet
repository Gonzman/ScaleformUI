-            i = i + 1
-        end
-
-        self.SettingsColumn:CurrentSelection(1)
-        self.SettingsColumn.Pagination:ScaleformIndex(self.SettingsColumn.Pagination:GetScaleformIndex(self.SettingsColumn:CurrentSelection()))
