diff --git a/ScaleformUI_Csharp/Menus/Pause Menus/PauseMenu/Items/PauseMenuItem.cs b/ScaleformUI_Csharp/Menus/Pause Menus/PauseMenu/Items/PauseMenuItem.cs
new file mode 100644
