{
  "compilerOptions": {
    "outDir": "./dist",
    "noImplicitAny": true,
    "module": "commonjs",
    "target": "es2020",
    "lib": ["es2020"],
    "paths": {
      "*": ["./src/*"]
    },
    "types": ["@citizenfx/client", "jest"],
    "inlineSourceMap": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "experimentalDecorators": true
  },
  "include": ["src/**/*", "jest.config.js"],
  "exclude": ["node_modules", "dist"]
}